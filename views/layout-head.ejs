<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'MESSAGE_BOARD' %></title>
  
  <style>
    :root {
      --bg: #0d0d0d;
      --surface: #161616;
      --border: #ffffff;
      --accent: #ff5e00; 
      --text: #f0f0f0;
      --muted: #888888;
      --border-thick: 3px solid var(--border);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Courier New', Courier, monospace, sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }


    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 2rem;
      background: var(--bg);
      border-bottom: var(--border-thick);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand {
      font-weight: 900;
      font-size: 1.5rem;
      letter-spacing: -1px;
      color: var(--accent);
      text-transform: uppercase;
      text-decoration: none;
    }

    .nav-links {
      display: flex;
      gap: 1rem;
    }

    .nav-btn {
      color: var(--text);
      text-decoration: none;
      font-weight: bold;
      text-transform: uppercase;
      padding: 0.5rem 1rem;
      border: 2px solid var(--text);
      background: transparent;
      box-shadow: 3px 3px 0px var(--text);
      transition: all 0.1s ease-in-out;
    }

    .nav-btn:hover {
      background: var(--accent);
      color: #000;
      box-shadow: 5px 5px 0px var(--accent);
      transform: translate(-2px, -2px);
    }

    
    .container {
      max-width: 800px;
      width: 100%;
      margin: 2rem auto;
      padding: 0 1.5rem;
      flex: 1;
    }

    
    .page-title {
      font-size: 2.5rem;
      text-transform: uppercase;
      margin-bottom: 2rem;
      border-left: 6px solid var(--accent);
      padding-left: 1rem;
      letter-spacing: -1px;
    }

    .btn-primary {
      display: inline-block;
      background: var(--accent);
      color: #000;
      font-weight: 900;
      text-transform: uppercase;
      padding: 0.8rem 1.5rem;
      border: var(--border-thick);
      box-shadow: 4px 4px 0px #fff;
      cursor: pointer;
      text-decoration: none;
      font-size: 1rem;
      text-align: center;
    }

    .btn-primary:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px #fff;
    }

    
    .brutalist-form {
      background: var(--surface);
      border: var(--border-thick);
      padding: 2rem;
      box-shadow: 8px 8px 0px var(--border);
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .form-group label {
      text-transform: uppercase;
      font-weight: bold;
      font-size: 0.85rem;
      letter-spacing: 1px;
      color: var(--accent);
    }

    .form-control {
      background: #000;
      border: 2px solid var(--border);
      color: #fff;
      padding: 0.8rem;
      font-size: 1rem;
      outline: none;
    }

    .form-control:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 1px var(--accent);
    }

    
    .message-grid {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      list-style: none;
    }
  </style>
</head>
<body>

  <nav class="navbar">
    <a href="/" class="brand">>_ msg_brd</a>
    <div class="nav-links">
      <a href="/" class="nav-btn">Feed</a>
      <a href="/new" class="nav-btn">+ New Post</a>
    </div>
  </nav>

  <main class="container">