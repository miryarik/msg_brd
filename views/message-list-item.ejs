<li style="
  background: var(--surface);
  border: var(--border-thick);
  padding: 1.5rem;
  box-shadow: 6px 6px 0px var(--border);
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
">
  <div style="display: flex; justify-content: space-between; align-items: baseline;">
    <h3 style="color: var(--accent); text-transform: uppercase; font-size: 1.2rem;">
      @<%= item.user %>
    </h3>
    <span style="color: var(--muted); font-size: 0.8rem;"><%= item.added %></span>
  </div>

  
  <p style="
    color: var(--text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  ">
    <%= item.text %>
  </p>

  <div style="margin-top: 0.5rem;">
    <a href="/message/<%= item.id %>" class="nav-btn" style="display: inline-block; font-size: 0.8rem; padding: 0.4rem 0.8rem;">
      Read Details →
    </a>
  </div>
</li>